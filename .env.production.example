# ==============================================================================
# PRODUCTION ENVIRONMENT FOR VPS (Copy to .env before running docker compose)
# ==============================================================================

# Domain hotel SaaS Anda (contoh: pms.namabrandanda.com)
# Biarkan :80 jika baru testing pakai IP VPS tanpa domain
APP_DOMAIN=pms.domainanda.com
CORS_ORIGIN=https://pms.domainanda.com

# Database PostgreSQL (Ganti dengan password kuat!)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_20_KARAKTER
POSTGRES_DB=hospitality_pms

# Security Secrets (Wajib generate acak minimal 32 karakter!)
# Jalankan di Linux/VPS: openssl rand -hex 32
JWT_ACCESS_SECRET=GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_32_ACCESS
JWT_REFRESH_SECRET=GANTI_DENGAN_HASIL_OPENSSL_RAND_HEX_32_REFRESH

# Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospitality_pms?schema=public"

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_ACCESS_SECRET=super-secret-jwt-access-key-change-in-production-2026
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hospitality-documents

# Default Property & Locale
DEFAULT_PROPERTY_CODE=WINOTOSASTRO-SOLO
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
DEFAULT_LOCALE=id

# Agoda OTA Configuration (Assumed)
AGODA_MOCK_PORT=4001
AGODA_API_BASE_URL=http://localhost:4001/agoda
